# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# Which build to run.
APP_MODE=insecure          # insecure | secure

# Server bind.
HOST=127.0.0.1
PORT=8000

# Base SQLite path (the active file gets a mode suffix, e.g. money_manager.insecure.db).
DB_PATH=money_manager.db

# --- secrets used by SECURE mode only ---
# JWT signing secret. Generate a strong random value for any real run:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=3600

# AES-256 key for at-rest field encryption. 32 bytes as 64 hex chars:
#   python -c "import secrets; print(secrets.token_hex(32))"
AES_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Login lockout tuning (secure mode).
MAX_FAILED_LOGINS=5
LOCKOUT_SECONDS=60
